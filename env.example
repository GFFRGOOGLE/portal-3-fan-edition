# ============================================================
# Portal 3: Fan Edition — Конфигурация бэкенда
# ============================================================
# 👑 AUTHOR       → gffrgogle.com@gmail.com
# 🔴 SUPER_ADMIN  → gffrfor@gmail.com
# 🔵 ADMIN        → portal3.fanedition.support@gmail.com
# 💎 SPONSOR      → назначается AUTHOR через PATCH /api/users/:id/role
# 🟢 USER         → все остальные
# ============================================================

# 🔐 ОБЯЗАТЕЛЬНО: JWT секрет (минимум 32 символа)
JWT_SECRET=your-super-secret-key-here-min-32-chars-long

# ⏱️ Срок токена
JWT_EXPIRES=7d

# 🗄️ База данных: json или mongodb
DB_TYPE=json

# 🍃 MongoDB URI (если DB_TYPE=mongodb)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portal3

# 🌐 CORS — разрешённые домены
CORS_ORIGIN=https://gffrgoogle.github.io,http://localhost:3000

# 📡 Порт
PORT=9000

# ⏱️ Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# 💬 Чат
CHAT_MAX_MESSAGES=500
CHAT_MAX_LENGTH=1000

# 🔒 Безопасность
PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=12

# 🤖 reCAPTCHA (опционально)
RECAPTCHA_SECRET=your-recaptcha-secret
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
